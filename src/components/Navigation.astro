---
import logo from '../assets/Final_logo.svg';
---

<header>
  <nav class="desktop-nav">
    <a href="/" class="logo">
      <img src={logo.src} alt="Uge 44" class="logo-billede" />
    </a>
    <div class="links">
      <a href="/om-uge-44">Materiale</a>
      <a href="/om-uge-44">Om Uge 44</a>
      <a href="/events" class="knap">Find Events</a>
    </div>
  </nav>

  <nav class="mobil-nav">
    <a href="/" class="logo">
      <img src={logo.src} alt="Uge 44" class="logo-billede" />
    </a>
    <button class="hamburger" id="hamburger" aria-label="Åbn menu"> &#9776; </button>
  </nav>

  <div class="mobil-menu" id="mobil-menu">
    <a href="/om-uge-44">Materiale</a>
    <a href="/om-uge-44">Om Uge 44</a>
    <a href="/events">Find Events</a>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobilMenu = document.getElementById('mobil-menu');

  hamburger?.addEventListener('click', () => {
    mobilMenu?.classList.toggle('aaben');
  });
</script>

<style>
  header {
    background-color: var(--farve-baggrund);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .logo {
    font-family: "Montserrat", sans-serif;
    font-weight: 900;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--farve-tekst);
  }

  .desktop-nav {
    display: none;
    justify-content: space-between;
    align-items: center;
  }

  .mobil-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .links a {
    text-decoration: none;
    color: var(--farve-tekst);
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .knap {
    background-color: #df742d;
    color: white !important;
    padding: 0.6rem 1.2rem;
    border-radius: 2rem;
    font-weight: 700 !important;
  }

  .hamburger {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--farve-tekst);
  }

  .mobil-menu {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
  }

  .mobil-menu.aaben {
    display: flex;
  }

  .mobil-menu a {
    text-decoration: none;
    color: var(--farve-tekst);
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    font-size: 1rem;
  }

  .logo-billede {
  height: 50px;
  width: auto;
}

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
    .mobil-nav {
      display: none;
    }
    .mobil-menu {
      display: none !important;
    }
  }
</style>
