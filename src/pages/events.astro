---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import EventCardGrid from "../components/EventCardGrid.astro";
import { createClient } from "@supabase/supabase-js";
import Hero from "../components/Hero.astro";
import FilterBar from "../components/FilterBar.astro";

const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

const { data: alleEvents, error } = await supabase.from("events").select("*").order("dato", { ascending: true });

console.log("Events:", alleEvents);
console.log("Fejl:", error);

const landsdele = [...new Set((alleEvents ?? []).map((e) => e.landsdel).filter(Boolean))];
const byer = [...new Set((alleEvents ?? []).map((e) => e.by).filter(Boolean))];
const datoer = [...new Set((alleEvents ?? []).map((e) => e.dato).filter(Boolean))];

// Læs URL-parametre
const url = new URL(Astro.request.url);
const valgtLandsdel = url.searchParams.get("landsdel") ?? "";
const valgtBy = url.searchParams.get("by") ?? "";
const valgtDato = url.searchParams.get("dato") ?? "";

// Filtrer events baseret på valgte parametre
const filtrerede = (alleEvents ?? []).filter((e) => {
  return (
    (!valgtLandsdel || e.landsdel === valgtLandsdel) &&
    (!valgtBy || e.by === valgtBy) &&
    (!valgtDato || e.dato === valgtDato)
  );
});

const viste = filtrerede.slice(0, 6);
const resten = filtrerede.slice(6);
---

<Layout>
  <main>
    <Hero />
    <FilterBar landsdele={landsdele} byer={byer} datoer={datoer} />
    <section class="events-sektion">
      <h2>Events</h2>
      <div class="events-grid" id="events-grid">
        {viste.map((event) => <EventCardGrid id={event.id} titel={event.titel} beskrivelse={event.beskrivelse} dag={event.dag} maaned={event.maaned} billede={event.billede_url} />)}
      </div>
      <button class="indlaes-flere" id="indlaes-btn">Indlæs flere ...</button>
    </section>
  </main>
</Layout>

<style>
  .events-sektion {
    padding: 2rem 1.5rem;
  }
  h1 {
    font-family: "Montserrat", sans-serif;
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  h2 {
    font-family: "Montserrat", sans-serif;
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 2rem 0 1rem;
  }
  .events-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .indlaes-flere {
    display: block;
    margin: 2rem auto 0;
    background: none;
    border: none;
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
</style>
